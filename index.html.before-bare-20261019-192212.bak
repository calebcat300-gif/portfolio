              class="size-8 object-contain grayscale" />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">Lua</span>
          </div>
          <div class="group relative">
            <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Bash_Logo_black_and_white_icon_only.svg" alt="Bash"
              class="size-8 object-contain grayscale" />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">Bash</span>
          </div>
          <div class="group relative">
