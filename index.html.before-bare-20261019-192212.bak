<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>endorphins.wiki</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap"
      rel="stylesheet"
    />
      <link rel="icon" href="data:," />
  </head>

  <body
    class="min-h-screen bg-black/70 bg-[url('/background.png')] bg-cover bg-center bg-no-repeat bg-blend-multiply font-bricolage"
  >
    <button
      id="music-toggle"
      type="button"
      class="fixed top-6 right-6 z-50 rounded-lg bg-[#181818] p-2 text-zinc-300 transition-colors hover:bg-zinc-800"
    ></button>
    <main class="mx-auto mt-16 grid max-w-6xl grid-cols-1 items-start gap-16 px-6 pb-16 lg:grid-cols-2">
  <div class="min-w-0">
      <!-- Profile -->
      <header class="mb-8 flex items-center gap-4">
        <img
          id="avatar"
          class="size-14 rounded-full object-cover shadow-lg ring-1 ring-black/10"
          alt="Discord avatar"
        />

        <div>
          <h1
            id="display_name"
            class="text-lg font-semibold text-zinc-500"
          ></h1>
          <p id="username" class="text-sm text-zinc-500"></p>
        </div>
      </header>

      <!-- Discord activity -->
      <div
        id="activity"
        class="flex items-center gap-3 rounded-lg border border-white/10 bg-[#181818] p-4 text-zinc-100 shadow-lg"
      >
        <img
          id="activity-icon"
          class="hidden size-14 shrink-0 rounded-lg object-cover grayscale"
          alt="Current activity icon"
        />

        <div class="min-w-0">
          <h3 id="activity-name" class="truncate text-sm font-semibold"></h3>
          <p id="activity-details" class="text-xs text-zinc-500"></p>
          <p id="activity-state" class="text-xs text-zinc-500"></p>
        </div>
      </div>

      <!-- Divider -->
      <hr class="my-8 border-0 border-t border-white/20" />

      
      <!-- Languages & Software -->
      <section>
        <h2 class="text-sm font-medium text-zinc-500">
          technologies i've worked with
        </h2>

        <div class="mt-8">
          <h3 class="mb-4 text-sm font-medium text-zinc-500">programming languages</h3>
          <div class="flex flex-wrap items-center gap-5">
          <div class="group relative">
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg"
              alt="TypeScript"
              class="size-8 object-contain grayscale"
            />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">TypeScript</span>
          </div>

          <div class="group relative">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/58/Assembly_Language_Logo.png/960px-Assembly_Language_Logo.png"
              alt="x86/x64 Assembly"
              class="size-8 object-contain grayscale"
            />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">x86/x64 Assembly</span>
          </div>
            
          <div class="group relative">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/cplusplus/cplusplus-original.svg" alt="C++"
              class="size-8 object-contain grayscale" />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">C++</span>
          </div>
          <div class="group relative">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/c/c-original.svg" alt="C"
              class="size-8 object-contain grayscale" />
            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-[#181818] px-2 py-1 text-xs text-zinc-200 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">C</span>
