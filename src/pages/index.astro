---
import { ClientRouter } from "astro:transitions";
import SiteMusic from "../components/SiteMusic.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <ClientRouter />
        <title>endorphins.wiki</title>
        <link
            rel="icon"
            type="image/x-icon"
            href="/favicon.ico?v=transparent-2"
        />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <script is:inline>
            (() => {
                const KEY = "endorphins-presence-preload-v1";
                const URL =
                    "https://api.rpc.devs.surf/v1/users/569305207947788289";

                // Browser may cache the home document before navigation.
                const link = document.createElement("link");
                link.rel = "prefetch";
                link.href = "/home";
                document.head.appendChild(link);

                function warmImage(url) {
                    if (!url) return;

                    const image = new Image();
                    image.decoding = "async";
                    image.src = url;

                    if (image.decode) {
                        image.decode().catch(() => {});
                    }
                }

                fetch(URL, { cache: "no-store" })
                    .then((response) => {
                        if (!response.ok)
                            throw new Error("Lanyard unavailable");
                        return response.json();
                    })
                    .then((payload) => {
                        const data = payload.data ?? payload;
                        if (!data) return;

                        try {
                            sessionStorage.setItem(
                                KEY,
                                JSON.stringify({
                                    data,
                                    at: Date.now(),
                                }),
                            );
                        } catch {}

                        // Preload the avatar before /home opens.
                        const user = data.discord_user;

                        if (user?.id && user?.avatar) {
                            warmImage(
                                `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128`,
                            );
                        }

                        // Preload standard Discord application assets.
                        const activity = data.activities?.find(
                            (a) => a.type === 0,
                        );
                        const asset = activity?.assets?.large_image;

                        if (asset?.startsWith("http")) {
                            warmImage(asset);
                        } else if (asset && activity?.application_id) {
                            if (asset.startsWith("mp:external/")) {
                                warmImage(
                                    `https://media.discordapp.net/external/${asset.slice(12)}`,
                                );
                            } else {
                                warmImage(
                                    `https://cdn.discordapp.com/app-assets/${activity.application_id}/${asset}.png`,
                                );
                            }
                        }
                    })
                    .catch(() => {
                        // /home will fetch normally if preloading fails.
                    });
            })();
        </script>
    </head>

    <body>
        <div id="app"></div>

        <script>
            import "../legacy/main.js";
        </script>
        <SiteMusic />

        <script>
            import { navigate } from "astro:transitions/client";

            (
                window as typeof window & {
                    __siteNavigateHome?: () => void;
                }
            ).__siteNavigateHome = () => {
                void navigate("/home");
            };
        </script>
    </body>
</html>
