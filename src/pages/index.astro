<ClientRouter />
<title>endorphins.wiki</title>
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=transparent-2" />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        </head>

    <body>
        <div id="app"></div>

        <script>
            import "../legacy/main.js";
        </script>
    <SiteMusic />

<script>
    import { navigate } from "astro:transitions/client";

    (window as typeof window & {
        __siteNavigateHome?: () => void
    }).__siteNavigateHome = () => {
        void navigate("/home");
    };
</script>

</body>
