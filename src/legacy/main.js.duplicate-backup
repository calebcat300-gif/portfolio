import "./style.css";

const DISCORD_ID = "1439728287608999956";
const RPC_URL = `https://rpc.fmod.dev/v1/users/${DISCORD_ID}`;

const app = document.querySelector("#app");

const state = {
  screen: "enter",
  presence: null,
  history: [
    {
      kind: "system",
      text: 'type "help" to view commands',
    },
  ],
};

function escapeHtml(value = "") {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function getDiscordAvatar(user) {
  if (!user?.id) return "";
  if (!user?.avatar) {
    return "https://cdn.discordapp.com/embed/avatars/0.png";
  }
  return `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png`;
}

function getActivityImage(activity) {
  const image =
    activity?.assets?.large_image || activity?.assets?.small_image || null;

  if (!image) return "";

  if (image.startsWith("mp:")) {
    return `https://media.discordapp.net/${image.slice(3)}`;
  }

  if (activity?.application_id) {
    return `https://cdn.discordapp.com/app-assets/${activity.application_id}/${image}.png`;
  }

  return "";
}

function getPrimaryActivity(data) {
  return (data?.activities || []).find((item) => item.type === 0) || null;
}

function addHistory(kind, text) {
  state.history.push({ kind, text });
}

function handleCommand(raw) {
  const value = raw.trim();
  if (!value) return;

  addHistory("command", `endorphins@endorphins:~$ ${value}`);

  const command = value.toLowerCase();

  if (command === "help") {
    addHistory(
      "system",
      [
        "available commands:",
        "home  - refresh the current home screen",
        "about - placeholder for the about page",
        "work  - placeholder for the work page",
        "clear - clear terminal output",
        "help  - show this command list",
      ].join("\n")
    );
    return;
  }

  if (command === "home") {
    addHistory(
      "system",
      [
        "home",
        "",
        "caleb aaron ellis",
        "local-first systems, terminal interfaces, low-level learning, and ai tooling.",
      ].join("\n")
    );
    return;
  }

  if (command === "about") {
    addHistory(
      "system",
      "about page is not implemented yet."
    );
    return;
  }

  if (command === "work") {
    addHistory(
      "system",
      "work page is not implemented yet."
    );
    return;
  }

  if (command === "clear") {
    state.history = [];
    renderHome();
    return;
  }

  addHistory("system", `unknown command: ${value}`);
}

async function loadPresence() {
  try {
    const response = await fetch(RPC_URL);
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = await response.json();
    state.presence = data;
  } catch (error) {
    console.error("Presence load failed:", error);
    state.presence = null;
  }

  if (state.screen === "home") {
    renderHome();
  }
}

function renderEnter() {
  app.innerHTML = `
    <main class="enter-screen">
      <div class="enter-wrap">
        <div class="enter-name">ENDORPHINS</div>
        <div class="enter-sub">press enter to continue</div>
      </div>
    </main>
  `;

  const onKeyDown = (event) => {
    if (event.key === "Enter") {
      window.removeEventListener("keydown", onKeyDown);
      state.screen = "home";
      renderHome();
      loadPresence();
    }
  };

  window.addEventListener("keydown", onKeyDown);
}

